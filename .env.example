# Contact form email (used by netlify/functions/contact.mjs).
# Locally: copy this file to `.env` and fill it in, then `npm run dev`.
# Production: add the same keys in Netlify → Site configuration → Environment variables.
#
# Emails are sent FROM the company mailbox ramankerzarkar@logicawork.com.
# logicawork.com email is hosted on GoDaddy, so only SMTP_PASS is required —
# everything else below already defaults to these values.

SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=ramankerzarkar@logicawork.com
SMTP_PASS=the-mailbox-password

# If the mailbox is "Microsoft 365 from GoDaddy" instead (login at outlook.office.com), use:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# (and make sure "Authenticated SMTP" is enabled for the mailbox in the Microsoft 365 admin centre)

# Where new leads are delivered (defaults to the same mailbox)
MAIL_TO=ramankerzarkar@logicawork.com
MAIL_FROM_NAME=LogicaWork Website
# Send the visitor a "we received your request" email (true/false)
SEND_ACK=true
SITE_URL=https://logicawork.com
ALLOWED_ORIGINS=https://logicawork.com,https://www.logicawork.com
